import numpy as np
import matplotlib.pyplot as plt

rng = np.random.default_rng(42)
fig, axes = plt.subplots(2, 2, figsize=(12, 8))
fig.suptitle("Exemples de courbes symétriques", fontsize=14)

# ── 1. Symétrie par rapport à l'axe des y (fonction paire) ──
x = np.linspace(-5, 5, 500)
axes[0, 0].plot(x, x**2, 'b', label=r'$y = x^2$')
axes[0, 0].plot(x, np.exp(-x**2 / 2) * 3, 'g', label=r'$y = 3e^{-x^2/2}$')
axes[0, 0].axvline(0, color='gray', ls='--', lw=1)
axes[0, 0].set_title("1. Paire : symétrie / axe y")
axes[0, 0].legend()

# ── 2. Symétrie par rapport à l'origine (fonction impaire) ──
axes[0, 1].plot(x, x**3 / 10, 'b', label=r'$y = x^3/10$')
axes[0, 1].plot(x, 3 * np.sin(x), 'g', label=r'$y = 3\sin(x)$')
axes[0, 1].axvline(0, color='gray', ls='--', lw=1)
axes[0, 1].axhline(0, color='gray', ls='--', lw=1)
axes[0, 1].set_title("2. Impaire : symétrie / origine")
axes[0, 1].legend()

# ── 3. Miroir d'une courbe existante ──
x_pts = np.array([0, 1, 2, 3, 4])
y_pts = np.array([0, 1, 3, 2, 0])
x_mir = 2 * x_pts[-1] - x_pts          # miroir par rapport à x = 4
axes[1, 0].plot(x_pts, y_pts, 'bo-', label="Courbe d'origine")
axes[1, 0].plot(x_mir, y_pts, 'ro--', label="Miroir (axe x = 4)")
axes[1, 0].axvline(4, color='gray', ls='--', lw=1)
axes[1, 0].set_title("3. Miroir d'une courbe")
axes[1, 0].legend()

# ── 4. Données bruitées rendues symétriques ──
x_b = np.linspace(-5, 5, 101)
y_b = 3 * np.exp(-x_b**2 / 2) + 0.3 * rng.standard_normal(len(x_b))
x_pos = x_b[x_b >= 0]
y_sym = (y_b[x_b >= 0][::-1] + y_b[x_b <= 0]) / 2   # moyenne des deux moitiés
axes[1, 1].plot(x_b, y_b, 'o', color='lightgray', label="Données bruitées")
axes[1, 1].plot(x_pos, y_sym, 'b.-', label="Symétrisée (moyenne)")
axes[1, 1].axvline(0, color='gray', ls='--', lw=1)
axes[1, 1].set_title("4. Données bruitées symétrisées")
axes[1, 1].legend()

for ax in axes.flat:
    ax.grid(alpha=0.3)

plt.tight_layout()
plt.show()
